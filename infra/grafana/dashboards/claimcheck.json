{
  "uid": "claimcheck",
  "title": "ClaimCheck",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "claimcheck",
    "llm",
    "rag"
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "prom",
        "label": "Prometheus",
        "query": "prometheus"
      },
      {
        "type": "datasource",
        "name": "tempo",
        "label": "Tempo",
        "query": "tempo"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Traffic & cost",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Questions (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase({__name__=~\"claimcheck_requests.*\"}[1h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Escalation rate (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase({__name__=~\"claimcheck_requests.*\", status=\"escalated\"}[1h])) / sum(increase({__name__=~\"claimcheck_requests.*\"}[1h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Refusal rate (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase({__name__=~\"claimcheck_requests.*\", status=\"refused\"}[1h])) / sum(increase({__name__=~\"claimcheck_requests.*\"}[1h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "LLM spend (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase({__name__=~\"claimcheck_llm_cost.*\"}[1h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Avg cost / question",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 5
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({__name__=~\"claimcheck_request_cost.*_sum\"}[1h])) / sum(rate({__name__=~\"claimcheck_request_cost.*_count\"}[1h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"claimcheck_request_duration.*_bucket\"}[15m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Questions by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate({__name__=~\"claimcheck_requests.*\"}[5m]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "p95 latency by stage",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate({__name__=~\"claimcheck_stage_duration.*_bucket\"}[5m])))",
          "legendFormat": "{{stage}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "LLM cost by stage",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate({__name__=~\"claimcheck_llm_cost.*\"}[5m]))",
          "legendFormat": "{{stage}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Answer quality (online)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Verifier: supported fraction (avg)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({__name__=~\"claimcheck_verifier_supported_fraction.*_sum\"}[10m])) / sum(rate({__name__=~\"claimcheck_verifier_supported_fraction.*_count\"}[10m]))",
          "legendFormat": "supported",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Verifier: claims removed / rewritten",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({__name__=~\"claimcheck_verifier_claims_removed.*\"}[10m]))",
          "legendFormat": "removed",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate({__name__=~\"claimcheck_verifier_claims_rewritten.*\"}[10m]))",
          "legendFormat": "rewritten",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        },
        {
          "refId": "C",
          "expr": "sum(rate({__name__=~\"claimcheck_verifier_escalations.*\"}[10m]))",
          "legendFormat": "escalations",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Retrieval: top rerank score & scope widening",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({__name__=~\"claimcheck_retrieval_top_score.*_sum\"}[10m])) / sum(rate({__name__=~\"claimcheck_retrieval_top_score.*_count\"}[10m]))",
          "legendFormat": "top score",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate({__name__=~\"claimcheck_retrieval_unscoped_retries.*\"}[10m]))",
          "legendFormat": "widened",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Tokens by model",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, direction) (rate({__name__=~\"claimcheck_llm_tokens.*\"}[5m]))",
          "legendFormat": "{{model}} {{direction}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Offline evals (latest run per variant)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 17,
      "type": "bargauge",
      "title": "Eval metrics by variant",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 16,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "legendFormat": "{{variant}} \u00b7 {{metric}}",
          "expr": "max by (variant, metric) (last_over_time({__name__=~\"claimcheck_eval_metric.*\", metric=~\"pass_rate|groundedness|key_fact_recall|retrieval_recall|citation_validity|verdict_accuracy|route_accuracy\"}[30d]))"
        }
      ]
    },
    {
      "id": 18,
      "type": "table",
      "title": "Eval cost & latency by variant",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 16,
        "y": 30,
        "w": 8,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "format": "table",
          "instant": true,
          "expr": "max by (variant, metric) (last_over_time({__name__=~\"claimcheck_eval_metric.*\", metric=~\"cost_usd_per_q|latency_p95_ms|escalation_rate\"}[30d]))"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "metric",
            "rowField": "variant",
            "valueField": "Value"
          }
        }
      ]
    },
    {
      "id": 19,
      "type": "row",
      "title": "Traces",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 20,
      "type": "table",
      "title": "Recent question traces (click a trace id)",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "traceql",
          "limit": 30,
          "query": "{ name = \"cc.question\" }"
        }
      ]
    }
  ]
}