# ---- Models (litellm format: provider/model) ------------------------------
# Cheap + fast model for router, planner, verifier. Smart model for the answerer.
# CC_FAST_MODEL=   # override config/models.yaml route "fast"
# CC_SMART_MODEL=  # override route "smart"
# The eval judge. Defaults to a stronger Claude tier than the answerer; a
# different model family (e.g. openai/...) is even better if you have a key,
# so the system is not grading its own homework.
# CC_JUDGE_MODEL=  # override route "judge"
# Set to "fake" to run everything offline with a deterministic stand-in LLM
# (no credits; used by tests and for dry-running the harness).
CC_LLM=litellm

ANTHROPIC_API_KEY=
# Optional: only needed if you point the judge route at an OpenAI model.
OPENAI_API_KEY=

# ---- Retrieval ------------------------------------------------------------
CC_EMBEDDER=fastembed        # fastembed (free, local) | hash (offline fallback)
CC_RERANKER=cross            # cross (local cross-encoder) | lexical | none
CC_RETRIEVAL_MODE=hybrid     # hybrid | vector | bm25

# ---- Observability --------------------------------------------------------
# Grafana LGTM stack from docker-compose (traces -> Tempo, metrics -> Prometheus)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=claimcheck
# Langfuse (cloud or self-hosted). Leave blank to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Pull agent prompts from Langfuse prompt management (falls back to local files).
CC_PROMPTS_FROM_LANGFUSE=false
